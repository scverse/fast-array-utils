from collections.abc import Sequence

class Type:
    def as_pointer(self, addrspace: int = 0) -> PointerType: ...

class PointerType(Type): ...
class VoidType(Type): ...

class IntType(Type):
    def __init__(self, bits: int) -> None: ...

class FloatType(Type): ...
class DoubleType(Type): ...

class VectorType(Type):
    element: Type
    count: int
    def __init__(self, element: Type, count: int) -> None: ...

class ArrayType(Type):
    def __init__(self, element: Type, count: int) -> None: ...

class FunctionType(Type):
    def __init__(self, return_type: Type, args: Sequence[Type], var_arg: bool = False) -> None: ...

class _Undefined: ...

Undefined: _Undefined

class Module: ...

class Value:
    type: Type

class Constant(Value):
    def __init__(self, typ: Type, constant: object) -> None: ...

class NamedValue(Value): ...
class Instruction(NamedValue): ...
class Function(NamedValue): ...

class IRBuilder:
    module: Module
    def load(self, ptr: Value, name: str = "", align: int | None = None) -> Instruction: ...
    def store(self, value: Value, ptr: Value, align: int | None = None) -> Instruction: ...
    def gep(self, ptr: Value, indices: Sequence[Value], inbounds: bool = False, name: str = "") -> Instruction: ...
    def bitcast(self, value: Value, typ: Type, name: str = "") -> Instruction: ...
    def add(self, lhs: Value, rhs: Value, name: str = "") -> Instruction: ...
    def mul(self, lhs: Value, rhs: Value, name: str = "") -> Instruction: ...
    def fsub(self, lhs: Value, rhs: Value, name: str = "") -> Instruction: ...
    def call(self, fn: Value, args: Sequence[Value], name: str = "") -> Instruction: ...
    def extract_value(self, agg: Value, idx: int | Sequence[int], name: str = "") -> Instruction: ...
    def insert_element(self, vector: Value, value: Value, idx: Value, name: str = "") -> Instruction: ...
    def shuffle_vector(self, vector1: Value, vector2: Value, mask: Constant, name: str = "") -> Instruction: ...
    def atomic_rmw(self, op: str, ptr: Value, val: Value, ordering: str, name: str = "") -> Instruction: ...
    def load_atomic(self, ptr: Value, ordering: str, align: int, name: str = "") -> Instruction: ...
    def store_atomic(self, value: Value, ptr: Value, ordering: str, align: int) -> Instruction: ...
    def cmpxchg(self, ptr: Value, cmp: Value, val: Value, ordering: str, failordering: str | None = None, name: str = "") -> Instruction: ...
