from llvmlite.ir import Constant, Value
from llvmlite.ir import Type as LLType
from numba.core.cgutils import _StructProxy
from numba.core.types import Type

class BaseContext:
    def make_array(self, typ: Type) -> type[_StructProxy]: ...
    def get_constant(self, ty: Type, val: object) -> Constant: ...
    def get_value_type(self, ty: Type) -> LLType: ...
    def get_data_type(self, ty: Type) -> LLType: ...
    def get_abi_sizeof(self, ty: LLType) -> int: ...
    def get_dummy_value(self) -> Value: ...
